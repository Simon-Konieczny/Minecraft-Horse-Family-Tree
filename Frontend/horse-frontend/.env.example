# Local dev defaults (host `npm run dev` + Mongo in Docker Desktop).
# Copy to .env.local for local work. Never commit .env.local.
# NOTE: from the host use 127.0.0.1; from inside a container use the
# service name `mongodb` (see docker-compose.yml).
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=horse
COLLECTION_NAME=horse
# Optional: override the Mongo collection names (defaults shown).
# Bloodlines + breeding settings live in their own collections so they
# survive DB/collection renames for the horse records above.
BLOODLINES_COLLECTION_NAME=bloodlines
SETTINGS_COLLECTION_NAME=settings
