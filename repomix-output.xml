    <div class="tab-stack">
        <div class="binder-tab active-tab" onclick="openTab(0)" title="Leaderboard">🏆</div>
        <div class="binder-tab" onclick="openTab(1)" title="Gen Stats">📈</div>
        <div class="binder-tab" onclick="openTab(2)" title="Genetic Breakdown">🧬</div>
    </div>

    <div id="page-0" class="binder-page active-page">
        <div class="page-header">TOP 16 (ALIVE ONLY)</div>
        <div style="display:flex; justify-content:space-around; margin-bottom:10px; border-bottom:1px solid #333; padding-bottom:10px; font-size:12px; font-weight:bold;">
            <span style="cursor:pointer; color:#FFD700;" onclick="switchTable('speed')" id="tab-speed">SPEED</span>
            <span style="cursor:pointer; color:#666;" onclick="switchTable('jump')" id="tab-jump">JUMP</span>
