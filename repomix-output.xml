        <table id="table-jump" style="display:none;">
            <thead><tr><th>#</th><th>NAME</th><th>JUMP</th></tr></thead>
            <tbody id="top-16-jump-body"></tbody>
        </table>
        <table id="table-health" style="display:none;">
            <thead><tr><th>#</th><th>NAME</th><th>HEALTH</th></tr></thead>
