    <div id="page-1" class="binder-page">
        <div class="page-header">PERFORMANCE BY GEN</div>
        <div class="graph-scroll-container">
            <div id="gen-performance-chart"></div>
        </div>
        <div style="font-size: 10px; color: #666; font-family: monospace; text-align: center;">
            ← SLIDE TO VIEW LINEAGE PROGRESSION →
        </div>
        <div class="minimize-btn" onclick="toggleBinder()">[ MINIMIZE BINDER ]</div>
