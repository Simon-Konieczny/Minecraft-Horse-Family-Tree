js_script = f"""
{ui_html}
<script>
var ancestorMap = {anc_json};
var descendantMap = {desc_json};
var stats = {stats_json};
var bloodColors = {js_color_map};
var top3Ranks = {top3_json};
var baseColors = {base_colors_json};

var currentMode = 'ancestors'; 
var currentStatMode = 'speed';
var currentHighlighted = null;

function toggleBinder() {{
    document.getElementById('binder-container').classList.toggle('active');
}}

function openTab(index) {{
    document.getElementById('binder-container').classList.add('active');
    document.querySelectorAll('.binder-page').forEach(p => p.classList.remove('active-page'));
    document.querySelectorAll('.binder-tab').forEach(t => t.classList.remove('active-tab'));
    document.getElementById('page-' + index).classList.add('active-page');
    document.querySelectorAll('.binder-tab')[index].classList.add('active-tab');
    
    setTimeout(() => {{
        window.dispatchEvent(new Event('resize'));
        if (index === 1) Plotly.Plots.resize('gen-performance-chart');
        if (index === 2) {{
            Plotly.Plots.resize('pie-alive');
            Plotly.Plots.resize('pie-all');
        }}
    }}, 50);
}}

const renderGenChart = () => {{
    const gens = Object.keys(stats.avg_speed);
    const speeds = Object.values(stats.avg_speed);
    
    const chartDiv = document.getElementById('gen-performance-chart');
    const dynamicWidth = Math.max(350, gens.length * 65); 
    if(chartDiv) chartDiv.style.width = dynamicWidth + "px";

    const data = [{{
        x: gens, y: speeds, mode: 'lines+markers', type: 'scatter',
        marker: {{ size: 10, color: '#00F5FF', line: {{ color: '#FFD700', width: 2 }} }},
        line: {{ color: '#00F5FF', width: 3, shape: 'spline' }},
        hovertemplate: '<b>Gen %{{x}}</b><br>Avg Speed: %{{y}}<extra></extra>',
    }}];

    const layout = {{
        margin: {{ l: 40, r: 40, t: 40, b: 60 }},
        paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
        xaxis: {{ title: "Generation", gridcolor: '#333', font: {{ color: '#888' }}, dtick: 1, fixedrange: true }},
        yaxis: {{ title: "Avg Speed", gridcolor: '#222', font: {{ color: '#888' }}, zeroline: false }},
        hoverlabel: {{ bgcolor: '#111', font: {{ family: 'monospace', color: '#fff' }} }}
    }};

    Plotly.newPlot('gen-performance-chart', data, layout, {{displayModeBar: false}});

    chartDiv.on('plotly_click', function(data) {{
        if (!data || !data.points) return;
        const selectedGen = data.points[0].x;
        const mainGraph = document.getElementsByClassName('plotly-graph-div')[0];
        const newOpacities = []; const newWidths = [];

        for(var i=0; i < mainGraph.data.length; i++) {{
            var trace = mainGraph.data[i];
            var isThisGen = trace.hovertext && trace.hovertext.includes("Gen: " + selectedGen);
            newOpacities.push(isThisGen ? 1.0 : 0.05);
            newWidths.push(isThisGen && trace.name.includes("line") ? 5.0 : (trace.name.includes("line") ? 0.1 : null));
        }}
        Plotly.restyle(mainGraph, {{ 'opacity': newOpacities, 'line.width': newWidths }});
    }});
}};

window.addEventListener('load', function() {{
    var graphDiv = document.getElementsByClassName('plotly-graph-div')[0];

    // Populate the 3 Leaderboards
    ['speed', 'jump', 'health'].forEach(stat => {{
        const tbody = document.getElementById(`top-16-${{stat}}-body`);
        const statKey = stat.charAt(0).toUpperCase() + stat.slice(1);
        stats[`top_16_${{stat}}`].forEach((h, i) => {{
            let row = document.createElement('tr');
            row.innerHTML = `<td>${{i+1}}</td><td>${{h.Name}}</td><td style="color:#FFD700; font-weight:bold;">${{h[statKey]}}</td>`;
            row.onclick = () => {{ currentHighlighted = h.Name; highlightLogic(h.Name); }};
            tbody.appendChild(row);
        }});
    }});

    window.switchTable = function(stat) {{
        ['speed', 'jump', 'health'].forEach(s => {{
            document.getElementById(`table-${{s}}`).style.display = (s === stat) ? 'table' : 'none';
            document.getElementById(`tab-${{s}}`).style.color = (s === stat) ? '#FFD700' : '#666';
        }});
    }};

    renderGenChart();

    const renderPie = (targetId, dataDict) => {{
        const labels = Object.keys(dataDict);
        const values = Object.values(dataDict);
        const colors = labels.map(l => bloodColors[l] || "#444444");
        const data = [{{
            values: values, labels: labels, type: 'pie', hole: 0.4,
            marker: {{ colors: colors, line: {{ color: '#121212', width: 2 }} }},
            textinfo: 'percent', hoverinfo: 'label+percent', textfont: {{ family: 'monospace', color: '#fff' }}
        }}];
        const layout = {{
            showlegend: true, legend: {{ orientation: 'h', font: {{ size: 10, color: '#888' }}, y: -0.2 }},
            margin: {{ t: 10, b: 10, l: 10, r: 10 }}, paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)'
        }};
        Plotly.newPlot(targetId, data, layout, {{displayModeBar: false}});
    }};

    renderPie('pie-alive', stats.blood_alive);
    renderPie('pie-all', stats.blood_all);

    // Core Highlight Filter
    window.highlightLogic = function(selectedHorse) {{
        var targetMap = (currentMode === 'ancestors') ? ancestorMap : descendantMap;
        var relatedSet = targetMap[selectedHorse] || [selectedHorse];
        var newOpacities = []; var newWidths = [];

        for(var i=0; i < graphDiv.data.length; i++){{
            var trace = graphDiv.data[i];
            var rawData = Array.isArray(trace.customdata) ? trace.customdata[0] : trace.customdata;
            var traceHorseName = (rawData && typeof rawData === 'object') ? rawData.child : rawData;
            var isRelated = false;
            
            if (trace.name === "node" || trace.name.startsWith("glow")) {{
                isRelated = relatedSet.includes(traceHorseName);
            }} else if (trace.name.includes("line")) {{
                isRelated = relatedSet.includes(traceHorseName) && (traceHorseName !== selectedHorse || currentMode === 'ancestors');
            }}
            newOpacities.push(isRelated ? 1.0 : 0.05);
            newWidths.push(isRelated && trace.name.includes("line") ? 5.0 : (trace.name.includes("line") ? 0.1 : null));
        }}
        Plotly.restyle(graphDiv, {{ 'opacity': newOpacities, 'line.width': newWidths }});
    }};

    window.toggleMode = function() {{
        currentMode = (currentMode === 'ancestors') ? 'descendants' : 'ancestors';
        var txt = document.getElementById('mode-text');
        txt.innerText = currentMode.toUpperCase();
        txt.style.color = (currentMode === 'ancestors') ? '#00F5FF' : '#FF4500';
        if (currentHighlighted) highlightLogic(currentHighlighted);
    }};

    window.toggleStatMode = function() {{
        if (currentStatMode === 'speed') currentStatMode = 'jump';
        else if (currentStatMode === 'jump') currentStatMode = 'health';
        else currentStatMode = 'speed';

        var txt = document.getElementById('stat-text');
        txt.innerText = "STAT: " + currentStatMode.toUpperCase();

        var statColors = {{ 'speed': '#FFD700', 'jump': '#00FF7F', 'health': '#FF004F' }};
        txt.style.color = statColors[currentStatMode];

        applyStatView();
    }};

    function applyStatView() {{
        var topList = top3Ranks[currentStatMode];

        var nodeIndices = []; var textUpdates = []; var symbolUpdates = [];
        var sizeUpdates = []; var lineWidthUpdates = []; var lineColorUpdates = [];
        var visibleUpdates = []; var glowIndices = [];

        for (var i = 0; i < graphDiv.data.length; i++) {{
            var trace = graphDiv.data[i];
            var tName = trace.name;

            if (tName && tName.startsWith("glow_")) {{
                glowIndices.push(i);
                visibleUpdates.push(tName === "glow_" + currentStatMode);
            }}
            else if (tName === "node") {{
                var rawData = Array.isArray(trace.customdata) ? trace.customdata[0] : trace.customdata;
                var hName = (rawData && typeof rawData === 'object') ? rawData.child : rawData;
                
                var rank = topList.indexOf(hName);
                var isGod = (rank === 0);
                
                var symbol = "circle";
                if (rank === 0) symbol = "star";
                else if (rank === 1) symbol = "diamond";
                else if (rank === 2) symbol = "triangle-up";

                var dName = isGod ? ("★ GOD HORSE: " + hName.toUpperCase() + " ★") : hName.toUpperCase();
                var size = (rank !== -1) ? 26 : 14;
                var lWidth = (rank !== -1) ? 4 : 1.5;
                var lColor = (rank !== -1) ? (rank === 0 ? "#FFD700" : (rank === 1 ? "#C0C0C0" : "#CD7F32")) : baseColors[hName];

                nodeIndices.push(i);
                textUpdates.push([dName]);
                symbolUpdates.push(symbol);
                sizeUpdates.push(size);
                lineWidthUpdates.push(lWidth);
                lineColorUpdates.push(lColor);
            }}
        }}

        if (glowIndices.length > 0) {{
            Plotly.restyle(graphDiv, {{ 'visible': visibleUpdates }}, glowIndices);
        }}
        if (nodeIndices.length > 0) {{
            Plotly.restyle(graphDiv, {{
                'text': textUpdates, 'marker.symbol': symbolUpdates, 'marker.size': sizeUpdates,
                'marker.line.width': lineWidthUpdates, 'marker.line.color': lineColorUpdates
            }}, nodeIndices);
        }}
    }}

    function resetToDefault() {{
        var ops = graphDiv.data.map(t => t.name === "line_parent" ? 0.3 : (t.name === "line_child" ? 0.45 : (t.name.startsWith("glow") ? 0.2 : 1.0)));
        var wds = graphDiv.data.map(t => t.name === "line_child" ? 2.5 : (t.name === "line_parent" ? 1.5 : null));
        Plotly.restyle(graphDiv, {{ 'opacity': ops, 'line.width': wds }});
        currentHighlighted = null;
    }}

    document.addEventListener('keydown', (e) => {{ 
        if(e.key.toLowerCase() === 'm') toggleMode(); 
        if(e.key.toLowerCase() === 's') toggleStatMode();
    }});

    graphDiv.on('plotly_click', function(data){{
        if (!data || !data.points) return;
        var pt = data.points[0]; var raw = pt.customdata;
        var name = (raw && typeof raw === 'object') ? (raw.child || raw[0]) : (Array.isArray(raw) ? raw[0] : raw);
        if (!name) return;
        if (currentHighlighted === name) resetToDefault();
        else {{ currentHighlighted = name; highlightLogic(name); }}
    }});
    graphDiv.addEventListener('mousedown', (e) => {{ if(e.target.classList.contains('nsewdrag')) resetToDefault(); }});
}});
</script>
"""

final_output = html_content.replace('</body>', js_script + '</body>')
with open("index.html", "w", encoding="utf-8") as f:
    f.write(final_output)

print("Process complete. 'index.html' updated with Stat Toggles and Alive Leaderboards.")
</file>

