    "avg_speed": avg_speed_gen,
    "blood_all": calculate_global_genetics(include_dead=True),
    "blood_alive": calculate_global_genetics(include_dead=False)
})

top3_json = json.dumps({"speed": top_3_speed, "jump": top_3_jump, "health": top_3_health})
base_colors_json = json.dumps({name: d["color"] for name, d in data_registry.items()})

anc_json, desc_json, js_color_map = json.dumps(ancestor_map), json.dumps(final_desc_map), json.dumps(origin_colors)

