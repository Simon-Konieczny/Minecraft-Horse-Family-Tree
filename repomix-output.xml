<file path="docker-compose.yml">
version: '3.8'

services:
  mongodb:
    image: mongo:latest
    container_name: horse_mongo
    restart: always
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db

  app:
    build:
      context: ./Frontend/horse-frontend
      dockerfile: Dockerfile
    container_name: horse_app
    restart: always
    ports:
      - "3000:3000"
    environment:
      - MONGODB_URI=mongodb://mongodb:27017
      - DB_NAME=horse-database
    depends_on:
      - mongodb

volumes:
  mongo_data:
</file>

