alive_df = df[df['Status'].astype(str).str.strip().str.lower() != 'dead']

top_16_speed_alive = alive_df.nlargest(16, 'Speed')[['Name', 'Speed']].to_dict('records')
top_16_jump_alive = alive_df.nlargest(16, 'Jump')[['Name', 'Jump']].to_dict('records')
top_16_health_alive = alive_df.nlargest(16, 'Health')[['Name', 'Health']].to_dict('records')

gen_speeds = {}
for name, data in data_registry.items():
